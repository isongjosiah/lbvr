# Storage tier API keys (per CLAUDE.md §7)
# Copy to .env and fill in real values. NEVER commit .env.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
IRYS_NODE_URL=https://node1.irys.xyz
IRYS_PRIVATE_KEY=

# L4 chain (generic). Pick ONE deployment target via CHAIN_RPC_URL +
# CHAIN_PRIVATE_KEY + CHAIN_ID + CHAIN_NAME. Per-network presets
# below are kept so deploy scripts still resolve their named alias.
CHAIN_NAME=
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_PRIVATE_KEY=
CHAIN_EXPLORER_URL=

# Polygon zkEVM Cardona testnet (chain ID 2442)
CARDONA_RPC_URL=https://rpc.cardona.zkevm-rpc.com
CARDONA_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# PureChain (PoA²; chain ID 900520900520; native token PCC)
PURECHAIN_RPC_URL=https://purechainnode.com
PURECHAIN_CHAIN_ID=900520900520
PURECHAIN_PRIVATE_KEY=
PURECHAIN_EXPLORER_URL=

# Deployed contract addresses (populated after D5 deployment).
# Same addresses are valid for whichever CHAIN_* preset is active —
# if you redeploy on a different chain, overwrite these values.
CID_REGISTRY_ADDRESS=
POR_VERIFIER_ADDRESS=
AUDITOR_LOG_ADDRESS=

# Gateway quorum (BLS12-381 keypairs for provenance signing)
# Generate with: go run ./cmd/verifier -keygen
GATEWAY_BLS_SK_1=
GATEWAY_BLS_SK_2=
GATEWAY_BLS_PK_1=
GATEWAY_BLS_PK_2=
